# Copy to backend/.env. These must match the credentials/ports in the root .env
# that docker-compose uses to create the containers.

PGHOST=localhost
PGPORT=5433
PGUSER=neurabid_app
PGPASSWORD=neurabid_local_dev_pw
PGDATABASE=neurabid

REDIS_URL=redis://localhost:6379

PORT=4000
NODE_ENV=development
