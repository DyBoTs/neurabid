# Copy to backend/.env. These must match the credentials/ports in the root .env
# that docker-compose uses to create the containers.

PGHOST=localhost
PGPORT=5433
PGUSER=neurabid_app
PGPASSWORD=neurabid_local_dev_pw
PGDATABASE=neurabid

REDIS_URL=redis://localhost:6379

PORT=4000
NODE_ENV=development

# Optional. If both are set, the server seeds (idempotently, on startup) a
# user with this username, this password, and role='admin' — so there's a
# working admin account in a fresh dev database without ever putting a
# password in source code. Safe to leave unset: no admin account is seeded,
# and one can still be promoted by hand (UPDATE users SET role = 'admin'
# WHERE username = '...') for local testing. Never commit real values here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-dev-only-password
