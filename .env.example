# Root .env — read by docker-compose.yml only (container credentials + host port mappings).
# Copy to `.env` in this same folder. Also copy backend/.env.example to backend/.env —
# the backend app reads its OWN .env, it does not read this root one.

PGUSER=neurabid_app
PGPASSWORD=neurabid_local_dev_pw
PGDATABASE=neurabid

# Host ports the containers are published on. 5433 (not 5432) is used for Postgres by
# default because a lot of dev machines already have a native Postgres on 5432 — if that's
# not true for you, feel free to change this to 5432 and update backend/.env to match.
PG_HOST_PORT=5433
REDIS_HOST_PORT=6379
